# Server Port (Default is 3001 to avoid conflict with Next.js on 3000)
PORT=3001

# PostgreSQL Connection String (Prisma format)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cyberrange?schema=public"

# JWT Secret Key for Token Signing (Change to a strong random 32+ character string in production)
JWT_SECRET="change-me-to-a-strong-secret-key-at-least-32-chars-long"

# Allowed CORS Origins (Comma-separated if multiple)
CORS_ORIGIN="http://localhost:3000"

# Node Environment
NODE_ENV="development"
